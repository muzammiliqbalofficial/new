# ==============================================================================
# Storefront General Configuration
# ==============================================================================
NEXT_PUBLIC_STORE_NAME="[YOUR STORE NAME]"
NEXT_PUBLIC_STORE_DOMAIN="[yourstore.com]"
NEXT_PUBLIC_WHATSAPP_NUMBER="[923000000000]"      # International format without '+'
NEXT_PUBLIC_CONTACT_EMAIL="[store@example.com]"
NEXT_PUBLIC_SHIPPING_FLAT_RATE="200"              # Flat shipping rate in PKR (placeholder until client confirms)

# ==============================================================================
# Supabase Configuration (Postgres & Auth)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"  # Seed and admin actions ONLY; NEVER expose to client
SUPABASE_DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ==============================================================================
# Cloudflare R2 Image Storage (S3-Compatible)
# ==============================================================================
NEXT_PUBLIC_R2_PUBLIC_URL="https://[images.yourstore.com]"    # Custom domain / CDN in front of R2 bucket
R2_ACCOUNT_ID="[YOUR-CLOUDFLARE-ACCOUNT-ID]"
R2_ACCESS_KEY_ID="[YOUR-R2-ACCESS-KEY-ID]"
R2_SECRET_ACCESS_KEY="[YOUR-R2-SECRET-ACCESS-KEY]"
R2_BUCKET_NAME="[YOUR-R2-BUCKET-NAME]"

# ==============================================================================
# ISR Cache Revalidation
# ==============================================================================
REVALIDATE_SECRET="[YOUR-SECURE-RANDOM-REVALIDATE-SECRET]"
