# Store Info
NEXT_PUBLIC_STORE_NAME="Tiny Kiddies"
NEXT_PUBLIC_STORE_DOMAIN="tinykiddies.pk"
NEXT_PUBLIC_WHATSAPP_NUMBER="923001234567"      # International format without '+'
NEXT_PUBLIC_CONTACT_EMAIL="info@tinykiddies.pk"
NEXT_PUBLIC_SHIPPING_FLAT_RATE="200"            # PKR flat shipping rate

# Supabase (Postgres & Auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key" # Server/seed only, never expose to client
SUPABASE_DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres"

# Cloudflare R2 Image Storage
NEXT_PUBLIC_R2_PUBLIC_URL="https://images.your-domain.com"
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="baby-store-images"

# ISR Cache Revalidation
REVALIDATE_SECRET="your-secure-random-revalidate-secret"
