# ==============================================================================
# Storefront General Configuration
# ==============================================================================
NEXT_PUBLIC_STORE_NAME="Tiny Kiddies"
NEXT_PUBLIC_STORE_DOMAIN="tinykiddies.pk"
NEXT_PUBLIC_WHATSAPP_NUMBER="923001234567"      # International format without '+'
NEXT_PUBLIC_CONTACT_EMAIL="info@tinykiddies.pk"
NEXT_PUBLIC_SHIPPING_FLAT_RATE="200"            # Flat rate in PKR

# ==============================================================================
# Supabase Configuration
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"  # Seed & admin server actions only; NEVER expose to client
SUPABASE_DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres"

# ==============================================================================
# Cloudflare R2 Image Storage (S3-Compatible)
# ==============================================================================
NEXT_PUBLIC_R2_PUBLIC_URL="https://images.tinykiddies.pk"   # Custom domain/CDN endpoint in front of R2 bucket
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="tinykids-images"

# ==============================================================================
# Cache Invalidation & Admin Security
# ==============================================================================
REVALIDATE_SECRET="your-secure-random-revalidate-secret"
